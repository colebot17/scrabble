{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "php-server",
            "type": "shell",
            "command": "php -S 0.0.0.0:3000",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "."
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "PHP.*Development Server.*started"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]
}