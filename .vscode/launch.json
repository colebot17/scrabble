    "version": "0.2.0",
    "configurations": [
        {
            "type": "firefox",
            "request": "launch",
            "name": "Debug in Firefox",
            "url": "http://127.0.0.1:3000",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "php-server"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Debug in Chrome",
            "url": "http://127.0.0.1:3000",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "php-server"
        }
    ]
}